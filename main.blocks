<xml xmlns="https://developers.google.com/blockly/xml">
  <variables></variables>
  <block type="pxt-on-start" id="on-start-block" x="0" y="0">
    <statement name="HANDLER">
      <block type="typescript_statement" id="ts-demo">
        <mutation xmlns="http://www.w3.org/1999/xhtml"
          line0="// AI Music Random — demo"
          line1="aiMusic.setSeed(42)"
          line2="aiMusic.applyMood(aiMusic.Mood.Happy)"
          line3="aiMusic.setVisualizer(aiMusic.Visualizer.Bars)"
          line4="aiMusic.playFullSong()"
          numlines="5">
        </mutation>
      </block>
    </statement>
  </block>
</xml>
